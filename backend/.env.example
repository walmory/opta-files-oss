# Opta Files — backend. Copie para `.env` (fora do Git, chmod 600).

# Motor de PDF privado (credenciais inline viram header Basic auth)
PDF_ENGINE_URL=http://localhost:8082
# Origens do frontend (produção). Vazio = só localhost:5173/4173.
ALLOWED_ORIGINS=
# Mesmo valor de VITE_API_TOKEN no frontend
API_TOKEN=
PORT=3001
# DATA_DIR=./data             # accounts.db, store por usuário e cache de fontes

# ---------------------------------------------------------------- contas
SESSION_DAYS=30
# Antiduplicidade (0 = sem limite)
MAX_ACCOUNTS_PER_DEVICE=2
MAX_SIGNUPS_PER_IP_DAY=3
# Domínios extras de e-mail bloqueados, separados por vírgula
BLOCKED_EMAIL_DOMAINS=

# Freemium — operações por dia no motor (0 = ilimitado)
ANON_DAILY_LIMIT=10
FREE_DAILY_LIMIT=50
PRO_DAILY_LIMIT=0

# ---------------------------------------------------------------- verificação (desligada por padrão)
# off | console (código aparece no log, só para teste) | resend
EMAIL_VERIFICATION=off
# off | console | whatsapp (Evolution API, grátis) | twilio (SMS, pago)
PHONE_VERIFICATION=off
# true = ferramentas de conta só funcionam depois de verificar os canais ativos
REQUIRE_VERIFIED=false

# resend.com (grátis até 3.000 e-mails/mês; exige domínio verificado)
RESEND_API_KEY=
EMAIL_FROM="Opta Files <nao-responda@seudominio.com>"
# Evolution API (WhatsApp) — self-hosted
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
