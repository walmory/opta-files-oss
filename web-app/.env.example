# Opta Files — frontend env. Copy to `.env` and fill in.

# Opta backend (PDF engine gateway + fonts + JSON store)
VITE_BACKEND_BASE_URL=http://127.0.0.1:3001

# Token compartilhado exigido pelo backend (mesmo valor de API_TOKEN em backend/.env).
# Nao e segredo de usuario: vai no bundle. Serve para barrar bots e abuso automatizado.
VITE_API_TOKEN=

# Optional — AI layout assistant in the editor
VITE_GEMINI_API_KEY=

# Optional — Google Maps (unused by the PDF editor, kept for config parity)
VITE_GOOGLE_MAPS_API_KEY=

# Branding
VITE_COMPANY_NAME=Opta Files
VITE_COMPANY_CURRENCY=GBP
VITE_COMPANY_LOCALE=pt-BR
